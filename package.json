{
  "name": "personal-tech-blog",
  "description": "A simple tech blog created with Gatsby",
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "cypress-headless": "cypress run --browser chrome --headless",
    "cypress-web": "cypress open",
    "build": "gatsby build",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "start": "gatsby develop",
    "serve": "gatsby serve",
    "cy:run": "cypress run",
    "unit-test": "jest --config jestconfig.json",
    "test-integration": "start-server-and-test serve http://localhost:9000 cy:run",
    "typecheck": "tsc --noEmit",
    "clean": "gatsby clean",
    "predevelop": "node -e \"require('fs').mkdirSync('.cache', { recursive: true })\"",
    "prestart": "node -e \"require('fs').mkdirSync('.cache', { recursive: true })\""
  },
  "dependencies": {
    "@mdx-js/mdx": "^2.3.0",
    "@mdx-js/react": "^2.3.0",
    "gatsby": "5.16.1",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-mdx": "^5.16.0",
    "gatsby-plugin-offline": "^6.16.0",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-styled-components": "^6.16.0",
    "gatsby-plugin-typescript": "^5.16.0",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.7.0",
    "react-select": "^5.10.2",
    "react-switch": "^7.1.0",
    "styled-components": "^6.6.0",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-helmet": "^6.1.11",
    "@types/react-select": "^5.0.1",
    "babel-plugin-styled-components": "^2.3.0",
    "codecov": "^3.8.3",
    "cypress": "^16.2.0",
    "expect": "^30.5.2",
    "gatsby-plugin-playground": "^1.0.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-styled-components": "^7.4.0",
    "prettier": "^3.9.10",
    "start-server-and-test": "^3.0.13",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=26 <27"
  }
